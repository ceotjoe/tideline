<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud backup or device transfer. The database is a plain file (ADR 0034),
  so it must not leave the device through Google backups, and restored
  secure-storage prefs cause InvalidKeyException (ADR 0006). Tideline offers
  its own backup file instead, which the user saves where they choose.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
