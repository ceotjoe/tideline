<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud backup or device transfer: the database key lives in the Android
  Keystore and is never transferred, so a restored copy could not be opened
  (and restored secure-storage prefs cause InvalidKeyException). Tideline
  offers its own passphrase-encrypted backup instead. See ADR 0006.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
