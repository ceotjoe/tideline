{
  "schema": 1,
  "id": "arrl-dx-cw",
  "version": 1,
  "name": "ARRL International DX Competition (CW)",
  "cabrillo": "ARRL-DX-CW",
  "adif": "ARRL-DX-CW",
  "modes": [
    "CW"
  ],
  "bands": [
    "160m",
    "80m",
    "40m",
    "20m",
    "15m",
    "10m"
  ],
  "exchange": {
    "sent": [
      {
        "kind": "rst"
      },
      {
        "kind": "power"
      }
    ],
    "rcvd": [
      {
        "kind": "rst"
      },
      {
        "kind": "state"
      }
    ],
    "variants": [
      {
        "when": {
          "myDxcc": [
            291,
            1
          ]
        },
        "sent": [
          {
            "kind": "rst"
          },
          {
            "kind": "state",
            "default": "{MY_STATE}"
          }
        ],
        "rcvd": [
          {
            "kind": "rst"
          },
          {
            "kind": "power"
          }
        ]
      }
    ]
  },
  "dupe": {
    "per": [
      "band"
    ]
  },
  "points": [
    {
      "when": {
        "myDxcc": [
          291,
          1
        ],
        "theirDxccNot": [
          291,
          1
        ]
      },
      "points": 3
    },
    {
      "when": {
        "myDxccNot": [
          291,
          1
        ],
        "theirDxcc": [
          291,
          1
        ]
      },
      "points": 3
    },
    {
      "points": 0
    }
  ],
  "multipliers": [
    {
      "id": "dxcc",
      "source": "dxcc",
      "per": "band",
      "when": {
        "myDxcc": [
          291,
          1
        ],
        "theirDxccNot": [
          291,
          1
        ]
      }
    },
    {
      "id": "state",
      "source": "rcvd:state",
      "per": "band",
      "when": {
        "myDxccNot": [
          291,
          1
        ],
        "theirDxcc": [
          291,
          1
        ]
      }
    }
  ],
  "score": "pointsTimesMultipliers"
}
