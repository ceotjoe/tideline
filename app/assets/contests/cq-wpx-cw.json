    },
    {
      "when": {
        "myContinent": "NA",
        "theirContinent": "NA",
        "band": [
          "160m",
          "80m",
          "40m"
        ]
      },
      "points": 4
    },
    {
      "when": {
        "myContinent": "NA",
        "theirContinent": "NA"
      },
      "points": 2
    },
    {
      "when": {
        "band": [
          "160m",
          "80m",
          "40m"
        ]
      },
      "points": 2
    },
    {
      "points": 1
    }
  ],
  "multipliers": [
    {
      "id": "prefix",
      "source": "wpxPrefix",
      "per": "contest"
    }
  ],
  "score": "pointsTimesMultipliers"
