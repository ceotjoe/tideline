{
  "schema": 1,
  "id": "darc-wag",
  "version": 1,
  "name": "Worked All Germany (WAG)",
  "cabrillo": "DARC-WAG",
  "adif": "WAG",
  "modes": [
    "CW",
    "PHONE"
  ],
  "bands": [
    "80m",
    "40m",
    "20m",
    "15m",
    "10m"
  ],
  "exchange": {
    "sent": [
      {
        "kind": "rst"
      },
      {
        "kind": "serial"
      }
    ],
    "rcvd": [
      {
        "kind": "rst"
      },
      {
        "kind": "dok"
      }
    ],
    "variants": [
      {
        "when": {
          "myDxcc": 230
        },
        "sent": [
          {
            "kind": "rst"
          },
          {
            "kind": "dok",
            "default": "{MY_DOK}"
          }
        ],
        "rcvd": [
          {
            "kind": "rst"
          },
          {
            "kind": "serial",
            "when": {
              "theirDxccNot": 230
            }
          },
          {
            "kind": "dok",
            "when": {
              "theirDxcc": 230
            }
          }
        ]
      }
    ]
  },
  "dupe": {
    "per": [
      "band",
      "modeCategory"
    ]
  },
  "points": [
    {
      "when": {
        "myDxcc": 230,
        "theirDxcc": 230
      },
      "points": 1
    },
    {
      "when": {
        "myDxcc": 230,
        "theirContinent": "EU"
      },
      "points": 3
    },
    {
      "when": {
        "myDxcc": 230,
        "theirDxccNot": 230
      },
      "points": 5
    },
    {
      "when": {
        "myDxccNot": 230,
        "theirDxcc": 230
      },
      "points": 3
    },
    {
      "points": 0
    }
  ],
  "multipliers": [
    {
      "id": "dxcc",
      "source": "dxcc",
      "per": "bandMode",
      "when": {
        "myDxcc": 230,
        "theirDxccNot": 230
      }
    },
    {
      "id": "dok-district",
      "source": "dokDistrict",
      "per": "bandMode",
      "when": {
        "myDxccNot": 230,
        "theirDxcc": 230
      }
    }
  ],
  "score": "pointsTimesMultipliers"
}
