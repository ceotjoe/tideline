{
  "schema": 1,
  "id": "cq-ww-ssb",
  "version": 1,
  "name": "CQ World Wide DX Contest (SSB)",
  "cabrillo": "CQ-WW-SSB",
  "adif": "CQ-WW-SSB",
  "modes": [
    "PHONE"
  ],
  "bands": [
    "160m",
    "80m",
    "40m",
    "20m",
    "15m",
    "10m"
  ],
  "exchange": {
    "sent": [
      {
        "kind": "rst"
      },
      {
        "kind": "cqZone",
        "default": "{MY_CQ_ZONE}"
      }
    ],
    "rcvd": [
      {
        "kind": "rst"
      },
      {
        "kind": "cqZone"
      }
    ]
  },
  "dupe": {
    "per": [
      "band"
    ]
  },
  "points": [
    {
      "when": {
        "sameDxcc": true
      },
      "points": 0
    },
    {
      "when": {
        "sameContinent": false
      },
      "points": 3
    },
    {
      "when": {
        "myContinent": "NA",
        "theirContinent": "NA"
      },
      "points": 2
    },
    {
      "points": 1
    }
  ],
  "multipliers": [
    {
      "id": "zone",
      "source": "rcvd:cqZone",
      "per": "band"
    },
    {
      "id": "country",
      "source": "dxcc",
      "per": "band"
    }
  ],
  "score": "pointsTimesMultipliers"
}
